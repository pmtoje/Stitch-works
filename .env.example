# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stitchworks"   # Supabase/any Postgres 14+ (needs btree_gist)
APP_URL="https://stitchworks.ng"                                    # public base URL; optional on Vercel (auto-detected)
APP_ENCRYPTION_KEY=""        # ≥32 random chars. Encrypts 2FA secrets. `openssl rand -base64 48`
CRON_SECRET=""               # bearer token for /api/cron. `openssl rand -hex 32`
STORAGE_DIR=""               # optional; default ./storage (must be persistent, outside the web root)
BLOB_READ_WRITE_TOKEN=""     # Vercel Blob: when set, uploads are stored there (set automatically by connecting a Blob store)
BLOB_ACCESS="private"        # "private" (default) or "public", matching the Blob store type

# ── Payments (Paystack) ──────────────────────────────────────────────
PAYMENT_PROVIDER="paystack"  # "paystack" | "mock" (test mode, never in production)
PAYSTACK_SECRET_KEY=""       # sk_test_… or sk_live_… — also used to verify webhook signatures
ALLOW_MOCK_PAYMENTS=""       # "true" ONLY on staging servers running NODE_ENV=production with test mode

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="StitchWorks Collective <no-reply@stitchworks.ng>"

# ── SMS (Termii) — optional ─────────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="StitchWorks"

# ── WhatsApp Business Cloud API — optional ─────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="stitchworks_update"

# ── Analytics / SEO — optional ───────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""

# ── Seeding ──────────────────────────────────────────────────────────
SEED_DEMO="false"            # "true" loads a sample Jos facility, inventory, plans, courses and demo accounts
SEED_ADMIN_EMAIL="admin@stitchworks.ng"
SEED_DEMO_PASSWORD=""        # password for seeded accounts — change immediately after first login
